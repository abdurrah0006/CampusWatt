# Base URL of the CampusWatt API.
# Leave as /api during development: Vite proxies /api to the backend (see vite.config.js).
# Set a full URL (e.g. https://campuswatt-api.example.com/api) when the API is hosted elsewhere.
VITE_API_URL=/api

# Where the Vite dev server proxies /api requests (development only)
VITE_PROXY_TARGET=http://localhost:5000
