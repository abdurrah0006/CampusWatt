# ---- Server ----
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed origins, or * for any (fine for a local demo)
CORS_ORIGIN=*

# ---- Data source ----
# mongo = read from MongoDB (falls back to JSON automatically if MongoDB is unreachable or empty)
# json  = always read the generated JSON files in src/data (no database needed)
DATA_SOURCE=mongo
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/campuswatt
# MongoDB Atlas (free tier) example:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campuswatt?retryWrites=true&w=majority
MONGO_TIMEOUT_MS=3000

# ---- Business rules (defaults shown) ----
# Electricity tariff assumption in AED per kWh (the real rate depends on utility and tariff band)
TARIFF_AED_PER_KWH=0.38
# An hour counts as "high" when kWh > room baseline x this multiplier
HIGH_USAGE_MULTIPLIER=1.5
# Hours analysed by the waste finder, and how many waste hours flag a room
WASTE_WINDOW_HOURS=24
MIN_WASTE_HOURS=2
# Days of history averaged for the forecast
FORECAST_LOOKBACK_DAYS=7
# Alerts: "warning" above this share of the threshold, "critical" above 100%
ALERT_WARNING_RATIO=0.9
# Daily limit = hourly threshold x 24 x this load factor
DAILY_LOAD_FACTOR=0.7
# Campus timezone offset from UTC (UAE = +4, no daylight saving)
CAMPUS_UTC_OFFSET_HOURS=4

# ---- IoT ingestion ----
# Required header for POST /api/energy/ingest: x-api-key: <INGEST_API_KEY>
INGEST_API_KEY=change-me-to-a-long-random-string

# ---- Optional LLM provider for recommendations ----
# Leave empty to use the built-in rule-based Smart Recommendation Engine.
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_TIMEOUT_MS=5000
